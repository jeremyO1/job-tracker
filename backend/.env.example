SUPABASE_URL=https://your-project.supabase.co
# Service-role key (Supabase -> Project Settings -> API). Keep it secret; backend only.
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
# Google OAuth client used to read Gmail. Its authorised redirect URIs must include
# {BACKEND_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
STATE_SECRET=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional tuning
# TRIAGE_MODEL=gpt-5-nano
# EXTRACT_MODEL=gpt-5-mini
# LLM_CONCURRENCY=8
# GMAIL_CONCURRENCY=10
# INITIAL_SYNC_DAYS=60
# MAX_EMAILS_PER_SYNC=500
